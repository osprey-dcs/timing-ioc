# Status
record(longin, "$(P)EVG:status") {
    field(DESC, "EVG status register")
    field(DTYP, "FEED Register Read")
    field(INP, "@name=$(NAME) reg=EVG:status")
    field(SCAN, ".1 second")
    field(FLNK, "$(P)EVG:SEQ:armd_")
}
record(calcout, "$(P)EVG:SEQ:armd_") {
    field(INPA, "$(P)EVG:status NPP MS")
    field(CALC, "(A>>4)&0xff")
    field(OUT , "$(P)EVG:SEQ:armd PP MS")
    field(FLNK, "$(P)EVG:SEQ:tgd_")
}
record(mbbiDirect, "$(P)EVG:SEQ:armd") {
    field(NOBT, "8")
}
record(calcout, "$(P)EVG:SEQ:tgd_") {
    field(INPA, "$(P)EVG:status NPP MS")
    field(CALC, "(A>>12)&0xff")
    field(OUT , "$(P)EVG:SEQ:tgd PP MS")
    field(FLNK, "$(P)EVG:SEQ:actv")
}
record(mbbiDirect, "$(P)EVG:SEQ:tgd") {
    field(NOBT, "8")
}
record(calc, "$(P)EVG:SEQ:actv") {
    field(INPA, "$(P)EVG:status NPP MS")
    field(CALC, "(A>>20)&0xf")
    field(FLNK, "$(P)EVG:SEQ:tModeR_")
}
record(calc, "$(P)EVG:SEQ:tModeR_") {
    field(INPA, "$(P)EVG:status NPP MS")
    field(CALC, "(A>>24)&0xff")
}

record(bi, "$(P)EVG:PPS:Vld") {
    field(DTYP, "FEED Register Read")
    field(INP, "@name=$(NAME) reg=EVG:status")
    field(SCAN, "I/O Intr")
    field(MASK, "0x1")
    field(ZNAM, "No PPS")
    field(ZSV , "MAJOR")
    field(ONAM, "Valid")
}
record(bi, "$(P)EVG:TS:Vld") {
    field(DTYP, "FEED Register Read")
    field(INP, "@name=$(NAME) reg=EVG:status")
    field(SCAN, "I/O Intr")
    field(MASK, "0x2")
    field(ZNAM, "No Time")
    field(ZSV , "MAJOR")
    field(ONAM, "Time OK")
}
record(bi, "$(P)EVG:PPS:Tgl") {
    field(DESC, "PPS activity toggle")
    field(DTYP, "FEED Register Read")
    field(INP, "@name=$(NAME) reg=EVG:status")
    field(SCAN, "I/O Intr")
    field(MASK, "0x4")
    field(ZNAM, "+")
    field(ONAM, "X")
}
record(bi, "$(P)EVG:SEQ:run") {
    field(DESC, "PPS activity toggle")
    field(DTYP, "FEED Register Read")
    field(INP, "@name=$(NAME) reg=EVG:status")
    field(SCAN, "I/O Intr")
    field(MASK, "0x800000")
    field(ZNAM, "Idle")
    field(ONAM, "Run")
}

record(longin, "$(P)EVG:SEQ:cnt_") {
    field(DESC, "Timer status")
    field(DTYP, "FEED Register Read")
    field(INP, "@name=$(NAME) reg=EVG:SEQ:nTrg")
    field(SCAN, ".1 second")
}

record(longin, "$(P)EVG:TRIG:cnt_") {
    field(DTYP, "FEED Register Read")
    field(INP ,  "@name=$(NAME) reg=EVG:TRG:count")
    field(SCAN, ".5 second")
}

# initial
record(longin, "$(P)EVG:onConnect_") {
    field(DESC, "Process records on FPGA connection")
    field(DTYP, "FEED On Connect")
    field(INP, "@name=$(NAME)")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P)EVG:init:1_")
}
# phase 1: probe, interrupt/stop previous
# sync
# phase 2: write known configuration
# sync
# phase 3: (re)start
record(fanout, "$(P)EVG:init:1_") {
    # probe static configuration
    field(LNK1, "$(P)EVG:nIn")
    # interrupt/shutdown
    field(LNK2, "$(P)EVG:SEQ:disarm:I_")
    field(LNK3, "$(P)EVG:SEQ:cancel:I_")
    field(LNK4, "$(P)EVG:TMR:stop_")
    field(FLNK, "$(P)EVG:sync:12_")
}
record(longin, "$(P)EVG:nIn") {
    field(DESC, "EVG # of trig. inputs")
    field(DTYP, "FEED Register Read")
    field(INP , "@name=$(NAME) reg=EVG:CONF:nIn")
    field(FLNK, "$(P)EVG:nTmr")
}
record(longin, "$(P)EVG:nTmr") {
    field(DESC, "EVG # of event timers")
    field(DTYP, "FEED Register Read")
    field(INP , "@name=$(NAME) reg=EVG:CONF:nTmr")
    field(FLNK, "$(P)EVG:nBank")
}
record(longin, "$(P)EVG:nBank") {
    field(DESC, "EVG # of seq. banks")
    field(DTYP, "FEED Register Read")
    field(INP , "@name=$(NAME) reg=EVG:CONF:nBank")
}
record(longout, "$(P)EVG:SEQ:disarm:I_") {
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:SEQ:disarm")
    field(VAL, "0xffff") # disarm all
}
record(longout, "$(P)EVG:SEQ:cancel:I_") {
    field(DESC, "Immediately cancel active sequence")
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:SEQ:cancel")
    field(VAL, "0xffff") # abort running all
}
record(longin, "$(P)EVG:sync:12_") {
    field(DTYP, "FEED Sync")
    field(INP , "@name=$(NAME)")
    field(FLNK, "$(P)EVG:init:2_")
}
# (re)initialize sub-units
record(fanout, "$(P)EVG:init:2_") {
    field(LNK1, "$(P)EVG:hbDivisor")
    field(LNK2, "")
    field(LNK3, "")
    field(FLNK, "$(P)EVG:rdy2_")
}
record(longout, "$(P)EVG:rdy2_") {
    field(OUT, "$(P)EVG:init4_ NPP") # prepare down counter
    field(VAL, "$(NTMR=0)")
    field(FLNK, "$(P)EVG:onConn2_")
}
record(event, "$(P)EVG:onConn2_") {
    field(VAL, "$(NAME):afterDisable") # --> to perEVG*.template
    #field(FLNK, "$(P)EVG:sync:23_")
}

record(calcout, "$(P)EVG:init4_") {
    field(SCAN, "Event")
    field(EVNT, "$(NAME):afterTimers") # <-- perEVGtimer.template
    field(CALC, "VAL-1")
    field(OOPT, "Transition To Zero")
    field(OUT , "$(P)EVG:sync:23_.PROC PP") # all outputs writes queued
}
record(longin, "$(P)EVG:sync:23_") {
    field(DTYP, "FEED Sync")
    field(INP , "@name=$(NAME)")
    field(FLNK, "$(P)EVG:init:3_")
}
record(fanout, "$(P)EVG:init:3_") {
    field(LNK1, "$(P)EVG:SEQ:armI_")
    field(LNK2, "$(P)EVG:TMR:start")
}

# settings
record(mbboDirect, "$(P)EVG:SEQ:armI_") {
    # B* fields pushed from perEVGseqBank.template
    field(OUT , "$(P)EVG:SEQ:arm PP MS")
}
record(longout, "$(P)EVG:SEQ:arm") {
    field(DESC, "Bitmap of sequencer(s) to arm")
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:SEQ:arm")
    field(LOPR, "0")
    field(HOPR, "15")
    field(DRVL, "0")
    field(DRVH, "15")
}
record(longout, "$(P)EVG:SEQ:disarm") {
    field(DESC, "Bitmap of sequencer(s) to disarm")
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:SEQ:disarm")
    field(LOPR, "0")
    field(HOPR, "15")
    field(DRVL, "0")
    field(DRVH, "15")
}
record(longout, "$(P)EVG:SEQ:swTrig") {
    field(DESC, "Bitmap of sequencer(s) to trigger")
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:SEQ:swTrig")
    field(LOPR, "0")
    field(HOPR, "15")
    field(DRVL, "0")
    field(DRVH, "15")
}
record(longout, "$(P)EVG:hbDivisor") {
    field(DESC, "Heartbeat event divisor")
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:hbDivisor")
    info(autosaveFields_pass0, "VAL")
}
record(longout, "$(P)EVG:swEvent") {
    field(DESC, "Event to send")
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:swEvent")
    field(LOPR, "0")
    field(HOPR, "255")
    field(DRVL, "0")
    field(DRVH, "255")
    field(VAL , "0")
}
record(longout, "$(P)EVG:SEQ:cancel") {
    field(DESC, "Immediately cancel active sequence")
    field(DTYP, "FEED Register Write")
    field(OUT,  "@name=$(NAME) reg=EVG:SEQ:cancel")
}
# TODO: EVG:MAP:dbus array
record(bo, "$(P)EVG:TMR:start") {
    field(DESC, "Reset/start all timers")
    field(ZNAM, "Reset")
    field(ONAM, "Reset")
    field(FLNK, "$(P)EVG:TMR:start_")
}
record(longout, "$(P)EVG:TMR:start_") {
    field(DESC, "Control timers")
    field(DTYP, "FEED Register Write")
    field(OUT , "@name=$(NAME) reg=EVG:TMR:control")
    # (re)start all timers
    field(VAL , "0xffffffff")
}
record(longout, "$(P)EVG:TMR:stop_") {
    field(DESC, "Control timers")
    field(DTYP, "FEED Register Write")
    field(OUT , "@name=$(NAME) reg=EVG:TMR:control")
    # (re)start all timers
    # stop all timers
    field(VAL , "0x55555555")
}
record(longin, "$(P)EVG:TMR:status") {
    field(DESC, "Timer status")
    field(DTYP, "FEED Register Read")
    field(INP, "@name=$(NAME) reg=EVG:TMR:status")
    field(SCAN, ".5 second")
}

# shift out next second value when in EVG mode
record(longin, "$(P)Nxt:Sec_") {
    field(SDIS, "$(P)FPGA:Mode NPP MSI")
    field(DISV, "0") # disable in "EVR Only" mode
    field(DTYP, "Next Second")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P)Nxt:Sec")
}
record(longout, "$(P)Nxt:Sec") {
    field(DOL , "$(P)Nxt:Sec_")
    field(OMSL, "closed_loop")
    field(DTYP, "FEED Register Write")
    field(OUT , "@name=$(NAME) reg=EVG:setSeconds")
}
