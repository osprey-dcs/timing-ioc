  {"fall", "f", 6, 7 }
  {"rise", "r", 7, 8 }
  {"fall", "f", 7, 8 }
  {"rise", "r", 8, 9 }
  {"fall", "f", 8, 9 }
  {"rise", "r", 9, 10 }
  {"fall", "f", 9, 10 }
