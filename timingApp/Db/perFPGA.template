record(calc, "$(P)PPS:DAC") {
    field(DESC, "PPS DAC RBV")
    field(INPA, "$(P)MARBLE:VCXO:ASR CP")
    field(INPB, "0xffff")
    field(CALC, "A&B")
    field(EGU , "arb")
}

