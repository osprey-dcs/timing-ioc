  <widget type="group" version="3.0.0">
    <name>Event Table</name>
    <x>290</x>
    <y>180</y>
    <width>492</width>
    <height>130</height>
    <style>1</style>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <transparent>true</transparent>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_3</name>
      <pv_name>$(P)EVG:SEQ:$(I):slo</pv_name>
      <x>360</x>
      <y>85</y>
      <format>3</format>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_4</name>
      <pv_name>$(P)EVG:SEQ:$(I):codes</pv_name>
      <x>140</x>
      <width>350</width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Entry_5</name>
      <pv_name>$(P)EVG:SEQ:$(I):times</pv_name>
      <x>140</x>
      <y>30</y>
      <width>350</width>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_3</name>
      <actions>
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(pv_name)</pv_name>
          <value>0</value>
        </action>
      </actions>
      <pv_name>$(P)EVG:SEQ:$(I):store</pv_name>
      <text>Write</text>
      <x>140</x>
      <y>60</y>
      <height>20</height>
    </widget>
    <widget type="led" version="2.0.0">
      <name>LED</name>
      <pv_name>$(P)EVG:SEQ:$(I):vld</pv_name>
      <x>260</x>
      <y>60</y>
      <width>70</width>
      <off_color>
        <color name="OK" red="0" green="255" blue="0">
        </color>
      </off_color>
      <on_color>
        <color name="MAJOR" red="255" green="0" blue="0">
        </color>
      </on_color>
      <square>true</square>
      <labels_from_pv>true</labels_from_pv>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_4</name>
      <text>Delay scaling</text>
      <x>360</x>
      <y>60</y>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_5</name>
      <text>Event codes</text>
      <width>130</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_6</name>
      <text>Event delays (EGU)</text>
      <y>30</y>
      <width>130</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_7</name>
      <text>Update Table</text>
      <y>60</y>
      <width>130</width>
    </widget>
  </widget>
</display>
